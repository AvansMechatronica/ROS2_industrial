<?xml version="1.0" ?>
<robot name="workshop_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="workshop_urdf" params="workshop_parent workshop_prefix  *origin">
  <xacro:property name="mesh_path" value="file://$(find ros_industrial_support)"/>


  <joint name="${workshop_prefix}joint" type="fixed">
    <xacro:insert_block name="origin" />
    <parent link="${workshop_parent}"/>
    <child link="${workshop_prefix}origin_pre"/>
  </joint>

  <link name="${workshop_prefix}origin_pre"/>

  <joint name="${workshop_prefix}joint_pre" type="fixed">
    <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
    <parent link="${workshop_prefix}origin_pre"/>
    <child link="${workshop_prefix}origin"/>
  </joint>

    <!-- Links -->
    <link name="${workshop_prefix}origin">
      <visual>
        <geometry>
          <mesh filename="${mesh_path}/models/workshop/meshes/workshop.dae" scale="1.1 1.1 1.1"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_path}/models/workshop/meshes/workshop.dae" scale="1.1 1.1 1.1"/>
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="1.0" ixy="0" ixz="0"
                 iyy="1.0" iyz="0"
                 izz="1.0" />
        <mass value="100" />
      </inertial>
    </link>
  </xacro:macro>
</robot>
