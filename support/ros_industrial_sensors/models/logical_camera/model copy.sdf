<?xml version="1.0"?>
<sdf version="1.6">
  <model name="custom_logical_camera">
    <static>true</static>

    <link name="custom_logical_camera">
      <visual name="visual">
        <pose>-0.02 0 -0.02 0 0 -1.5708</pose>
        <geometry>
          <mesh>
            <uri>model://logical_camera/meshes/camera.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <plugin
          filename="libgz-sensors8-logical_camera.so"
          name="gz::sim::sensors::LogicalCameraSensor">
      </plugin>
    </link>
  </model>
</sdf>
